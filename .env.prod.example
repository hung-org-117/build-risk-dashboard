# =============================================================================
# Production Environment Configuration
# Copy this to .env on your production server
# =============================================================================

# =============================================
# Domain & URLs (REQUIRED)
# =============================================
NEXT_PUBLIC_API_URL=http://your-domain-or-ip:8000/api

FRONTEND_BASE_URL=http://your-domain-or-ip:3000

# =============================================
# Security (REQUIRED - Generate strong secrets!)
# =============================================
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production

# =============================================
# Database
# =============================================
MONGODB_DB_NAME=buildguard

# =============================================
# RabbitMQ
# =============================================
RABBITMQ_USER=myuser
RABBITMQ_PASS=change-me-strong-password

# =============================================
# GitHub App Configuration (REQUIRED)
# =============================================
GITHUB_APP_ID=your-app-id
GITHUB_APP_PRIVATE_KEY="builddefection.2025-11-17.private-key.pem"
GITHUB_INSTALLATION_ID=your-installation-id
GITHUB_CLIENT_ID=your-client-id
GITHUB_CLIENT_SECRET=your-client-secret
GITHUB_WEBHOOK_SECRET=choose-a-shared-secret
# OAuth callback URL (must match GitHub App settings)
GITHUB_REDIRECT_URI=http://your-domain-or-ip/api/auth/github/callback

# =============================================
# GitHub Organization for RBAC (REQUIRED)
#Only users from this org can access the app
# =============================================
GITHUB_ORGANIZATION=your-github-org

# =============================================
# GitHub Tokens (Rate Limiting)
# =============================================
# For Trivy vulnerability DB updates (Single PAT)
GITHUB_TOKEN=your-github-token-for-trivy

# Comma-separated list of PATs for GitHub API pool (Backend data fetching)
GITHUB_TOKENS=["ghp_token1","ghp_token2"]

# =============================================
# Advanced Tuning (Optional)
# =============================================
# GitHub API Rate Limit (Requests per second) - Default: 100.0 (Too high for personal tokens)
GITHUB_API_RATE_PER_SECOND=2.0
GITHUB_API_BURST_ALLOWANCE=10

# Celery Task Timeouts (Seconds) - Default: 900 (Too short for large repos)
CELERY_TASK_SOFT_TIME_LIMIT=1800
CELERY_TASK_TIME_LIMIT=2000

# =============================================
# CI Provider Tokens (Optional)
# =============================================
# CIRCLECI_TOKEN=
# TRAVIS_TOKEN=

# =============================================
# SonarQube Configuration
# =============================================
SONAR_TOKEN=
SONAR_DEFAULT_PROJECT_KEY=build-risk
SONAR_WEBHOOK_SECRET=change-me-to-secure-secret
# URL used by Backend to communicate with SonarQube
# Default (Docker Internal): http://sonarqube:9000
# Local Dev: http://localhost:9000
SONAR_HOST_URL=http://sonarqube:9000

# =============================================
# Trivy Configuration
# =============================================
# URL used by Backend to communicate with Trivy
# Default (Docker Internal): http://trivy:4954
# Local Dev: http://localhost:4954
TRIVY_SERVER_URL=http://trivy:4954

# =============================================
# Email (Gmail API) - Optional
# =============================================
GMAIL_ENABLED=true
GMAIL_SENDER_EMAIL=bot@yourdomain.com
GMAIL_CLIENT_ID=your-google-client-id
GMAIL_CLIENT_SECRET=your-google-client-secret
GMAIL_REFRESH_TOKEN=your-google-refresh-token

# =============================================
# Workers
# =============================================
CELERY_CONCURRENCY=4

# =============================================
# Container Permissions (run: id -u && id -g)
# =============================================
APP_UID=1000
APP_GID=1000

# =============================================
# Data Storage Path (Matches Docker Volume /app/data)
# =============================================
DATA_DIR=/app/data
